# ==============================================================
# DataPulse - Environment Configuration Template
# ==============================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in this same folder:
#    cp .env.example .env
# 2. Fill in your actual secrets and connection strings in `.env`.
# 3. NEVER commit your `.env` file to GitHub or version control!
# ==============================================================

# Flask Core Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Supabase PostgreSQL Connection URL
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# TIP: For serverless (Vercel), always use the Supavisor Pooler URL (port 6543) in Transaction Mode.
# If left blank, DataPulse will fallback to a local SQLite database for offline development.
DATABASE_URL=

# Google Sheets API Integration (For Activity Logging in Phase 3)
# ID of the Google Sheet created for audit logging (from the sheet URL)
GOOGLE_SHEET_ID=
# Single-line JSON string of your Google Cloud Service Account credentials
GOOGLE_SERVICE_ACCOUNT_JSON=

# Application Upload Limits
MAX_CONTENT_LENGTH=16777216  # 16 MB maximum CSV upload size in bytes
